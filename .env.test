# Firebase — test-only placeholders, NOT real credentials. Safe to commit.
# See src/firebase/firebase.js (the module-level env-var guard this exists
# to satisfy) and src/firebase/firebase.test.js (which tests that guard
# directly). Vite/Vitest load this automatically in test mode.
VITE_FIREBASE_API_KEY=test-api-key-not-real
VITE_FIREBASE_AUTH_DOMAIN=code-club-test.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=code-club-test
VITE_FIREBASE_STORAGE_BUCKET=code-club-test.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Backend API — unused directly in unit tests (apiFetch itself is always
# mocked), but set for consistency with .env.example.
VITE_API_URL=http://localhost:5000
