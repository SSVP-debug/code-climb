# Firebase (from Firebase Console > Project settings)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Backend API
VITE_API_URL=http://localhost:5000

# Optional: direct Judge0 URL (default uses backend proxy at /api/compiler/run)
# VITE_JUDGE0_API_URL=

# Feature flags (default OFF — see src/config/featureFlags.js)
# VITE_WORKSPACE_V2_ENABLED=true

# Official contact channels — public info, not secrets, but kept
# configurable via env so they can change without a code deploy. Any left
# blank simply hides that channel in the UI (footer + Club page "Get in
# Touch" section) — see src/config/site.js and ContactChannels.jsx.
# WhatsApp number in international format, digits only (no "+", spaces, or
# dashes) — used to build the wa.me link.
VITE_CODECLUB_WHATSAPP=910000000000
VITE_CODECLUB_DISCORD=https://discord.gg/example
VITE_CODECLUB_EMAIL=connect@example.com
